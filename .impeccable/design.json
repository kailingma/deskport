  "narrative": {
    "northStar": "A Page of the Dashboard",
    "overview": "deskport is a single-purpose app that should look like it belongs next to the Cloudflare dashboard, then Vercel and Tailscale: Inter, untinted greys, hairline borders, one blue, and nothing that is there only to look designed. The remote screen and the terminal are the content; every piece of chrome exists to name the machine, show whether it is connected, switch views, or reach a few desktop keys, and then stay out of the way.\n\nDensity is low-to-moderate and calm. Controls are 32px on desktop and grow to 40px on coarse pointers. Depth is a single hairline-plus-soft-shadow vocabulary. There is no illustration, no gradient in the UI, no decorative motion. The one expressive object is the app icon, which lives outside the interface.",
    "keyCharacteristics": [
      "Inter Variable throughout the chrome; the terminal has its own selectable monospace.",
      "Neutral oklch greys with zero chroma for ground, surface and borders.",
      "One blue (hue 260) for primary action, selection and focus. Green, amber and red appear only as connection state.",
      "Light and dark follow the system; the user can override with Settings, stored as html[data-theme].",
      "Radii: 6px small, 8px controls, 12px floating surfaces, 16px for bottom sheets.",
      "The remote screen sits on a near-black stage in both themes."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Blue marks the thing you can act on or that is selected. It is never decoration, and no second hue is introduced for emphasis.",
        "section": "colors"
      },
      {
        "name": "The State-Only Rule",
        "body": "Green, amber and red mean connection state and nothing else. They do not colour buttons, headings or categories.",
        "section": "colors"
      },
      {
        "name": "The Untinted Grey Rule",
        "body": "Greys have zero chroma. Warmth or tint would pull the system away from the dashboard reference.",
        "section": "colors"
      },
      {
        "name": "The Weight-Not-Size Rule",
        "body": "Distinguish levels with weight and ink colour first; the sizes stay within 11 to 16px.",
        "section": "typography"
      },
      {
        "name": "The One Float Rule",
        "body": "Only elements that sit above the remote content use Float. Everything in the normal flow is flat with a hairline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep chrome neutral grey with 1px hairlines and let the remote screen and terminal be the loudest things on screen.",
      "Do use Dashboard Blue only for the primary action, selection, toggled state and focus.",
      "Do use state colours only to show connection state, and always pair them with the text label in the badge.",
      "Do size touch targets up on coarse pointers (40px icon buttons, 36px by 44px keys, 48px sheet rows).",
      "Do support both themes through the --* tokens and the html[data-theme] override; define new colours for both.",
      "Do use inline SVG line icons at 1.75 stroke and keep new controls to the 6, 8, 12px radius set."
    ],
    "donts": [
      "Don't add decorative elements, themed chrome, gradients or illustration to the interface; the gradient belongs to the app icon only.",
      "Don't tint the greys or introduce a second accent hue.",
      "Don't use shadows on in-flow surfaces; reserve Float for things above the remote content.",
      "Don't hide connection state or make it depend on colour alone.",
      "Don't load fonts or assets from outside the repo; CSP is 'self' only."
    ]
  }
}