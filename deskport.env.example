# Copy to ~/.config/deskport/deskport.env (chmod 600).
# Team domain from Zero Trust > Settings > Custom pages, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from the Access application's overview
CF_ACCESS_AUD=
# Optional extra check on top of the Access policy (comma-separated)
DESKPORT_ALLOWED_EMAILS=
# DESKPORT_PORT=7900
# GUACD_HOST=127.0.0.1
# GUACD_PORT=4822
# RDP_PORT=3390
# DESKPORT_TMUX_SESSION=web
